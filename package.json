{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint resources/js --ext .ts,.vue",
        "format": "prettier --check \"resources/**/*.{js,ts,vue,css}\"",
        "build": "vite build",
        "dev": "vite",
        "cap:sync": "npx cap sync",
        "cap:sync:link": "CAP_APP=link npx cap sync",
        "cap:sync:store": "CAP_APP=store npx cap sync",
        "cap:sync:academy": "CAP_APP=academy npx cap sync",
        "cap:sync:messenger": "CAP_APP=messenger npx cap sync",
        "cap:android": "npx cap add android",
        "cap:ios": "npx cap add ios",
        "cap:assets": "python3 scripts/generate_mobile_assets.py",
        "cap:open:android": "npx cap open android",
        "cap:open:ios": "npx cap open ios"
    },
    "dependencies": {
        "@capacitor/android": "^7.6.10",
        "@capacitor/app": "^7.1.2",
        "@capacitor/browser": "^7.0.5",
        "@capacitor/core": "^7.4.3",
        "@capacitor/ios": "^7.6.10",
        "@capacitor/push-notifications": "^7.0.7",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "jsqr": "^1.4.0",
        "laravel-echo": "^2.6.3",
        "leaflet": "^1.9.4",
        "pinia": "^3.0.3",
        "pusher-js": "^8.6.0",
        "qrcode": "^1.5.4",
        "vue": "^3.5.22",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@capacitor/cli": "^7.4.3",
        "@tailwindcss/vite": "^4.0.0",
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "@typescript-eslint/parser": "^8.46.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "concurrently": "^10.0.3",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.4.0",
        "globals": "^14.0.0",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.6.2",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.0",
        "vue-tsc": "^3.1.1"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
