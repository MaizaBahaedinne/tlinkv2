APP_NAME="T.Link"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Tunis

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sous-domaines (facultatif, voir docs/subdomains.md) : site vitrine, T.Link, Store, Academy
# Laisser commentés tant que le découpage n'est pas activé (des valeurs vides gêneraient les tests).
# DOMAIN_SITE=tunivisionsfoundation.org
# DOMAIN_APP=link.tunivisionsfoundation.org
# DOMAIN_STORE=store.tunivisionsfoundation.org
# DOMAIN_ACADEMY=academy.tunivisionsfoundation.org
# DOMAIN_MESSENGER=messenger.tunivisionsfoundation.org

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Connexion Google (callback : {APP_URL}/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Notifications push (Firebase Cloud Messaging), facultatif : chemin du fichier JSON du compte de service Firebase (voir docs/messenger.md).
# FCM_CREDENTIALS=/home/tunivisionsfoundation.org/secrets/firebase-service-account.json

# Messagerie temps réel (Laravel Reverb), facultatif : sans ces valeurs, la messagerie s'actualise par interrogation (voir docs/messenger.md).
# (remplacer BROADCAST_CONNECTION=log ci-dessus par : BROADCAST_CONNECTION=reverb)
# REVERB_APP_ID=tlink
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=ws.tunivisionsfoundation.org
# REVERB_PORT=443
# REVERB_SCHEME=https
# REVERB_SERVER_HOST=127.0.0.1
# REVERB_SERVER_PORT=8080
# REVERB_ALLOWED_ORIGINS=link.tunivisionsfoundation.org,messenger.tunivisionsfoundation.org,store.tunivisionsfoundation.org,academy.tunivisionsfoundation.org
